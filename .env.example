# Free API key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your-football-data-org-key

# Comma-separated origins allowed to call the API from a browser.
# Leave unset to allow any origin (*). Add http://localhost:5500 for local frontend testing.
ALLOWED_ORIGINS=https://goalpool.co.ke,https://www.goalpool.co.ke,http://localhost:5500
